#!/usr/bin/env sh

# Native settings, Space policy, and persistent rules belong in yabai.jsonc.
# yabairc runs after native JSONC and remains the compatibility layer for
# runtime overrides, signals, imperative startup actions, and shell logic.

# Runtime setting overrides win until the next successful JSONC reload.
yabai -m config focus_follows_mouse off
yabai -m config --space 1 layout bsp

# Rules added here follow the native rule prefix and affect future windows.
# Use "rule --apply" explicitly when an existing window must be reconsidered.
yabai -m rule --add label=runtime-browser app='^Safari$' manage=on

# Signals and arbitrary commands are intentionally not part of JSONC.
yabai -m signal --add event=space_changed \
    action='echo "yabai: focused Space changed" >&2'

# Scripting-addition setup is also an imperative compatibility task. Configure
# sudo for passwordless execution before enabling these commands.
# yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"
# sudo yabai --load-sa

# Other startup actions can remain here, for example:
# yabai -m space --focus 1
